<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <AuthorizeView>
                    <Authorized Context="_auth">
                        @* Autenticado pero sin el rol requerido *@
                        <LayoutView Layout="@typeof(MainLayout)">
                            <AccesoDenegado />
                        </LayoutView>
                    </Authorized>
                    <NotAuthorized Context="_noAuth">
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Página no encontrada</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">No se encontró nada en esta dirección.</p>
        </LayoutView>
    </NotFound>
</Router>

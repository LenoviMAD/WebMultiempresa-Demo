@page "/usuarios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using WebMultiempresa.Application.DTOs
@using WebMultiempresa.Application.Queries.Usuarios
@inject ListarUsuariosQuery UsuariosQuery
@inject NavigationManager Nav
@inject ILogger<ListaUsuarios> Logger

<PageTitle>Usuarios</PageTitle>

<div class="page-header">
    <h2>Usuarios</h2>
    <a href="/usuarios/nuevo" class="btn-primary">+ Nuevo usuario</a>
</div>

@if (_cargando)
{
    <div class="loading">Cargando usuarios...</div>
}
else if (_usuarios.Count == 0)
{
    <div class="empty-state">No hay usuarios activos.</div>
}
else
{
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Empresa</th>
                    <th>Rol</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (UsuarioListadoDto u in _usuarios)
                {
                    <tr>
                        <td>@u.Nombre</td>
                        <td class="mono">@u.Email</td>
                        <td>@(u.NombreEmpresa ?? "— SuperAdmin —")</td>
                        <td>
                            <span class="badge @(u.Rol == 0 ? "badge-super" : "badge-admin")">
                                @(u.Rol == 0 ? "SuperAdmin" : "Admin")
                            </span>
                        </td>
                        <td><a href="/usuarios/@u.UsuariosID" class="btn-link">Editar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert-error">@_error</div>
}

<style>
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
    .page-header h2 { margin: 0; font-size: 1.5rem; font-weight: 700; color: #1e3a5f; }
    .btn-primary { background: #2563eb; color: #fff; border: none; border-radius: 6px; padding: 0.5rem 1.125rem; font-size: 0.875rem; font-weight: 600; text-decoration: none; }
    .btn-primary:hover { background: #1d4ed8; }
    .table-container { background: rgba(255,255,255,0.98); border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); overflow: auto; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    .data-table th { background: #f8fafc; padding: 0.75rem 1rem; text-align: left; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb; }
    .data-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #f3f4f6; color: #1f2937; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: #f9fafb; }
    .mono { font-family: monospace; font-size: 0.85rem; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 99px; font-size: 0.75rem; font-weight: 600; }
    .badge-super { background: #ede9fe; color: #5b21b6; }
    .badge-admin { background: #dbeafe; color: #1e40af; }
    .btn-link { color: #2563eb; text-decoration: none; font-size: 0.85rem; font-weight: 500; }
    .btn-link:hover { text-decoration: underline; }
    .loading, .empty-state { padding: 2rem; text-align: center; color: #6b7280; }
    .alert-error { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 0.75rem 1rem; border-radius: 6px; margin-top: 1rem; }
</style>

@code {
    private List<UsuarioListadoDto> _usuarios = new();
    private bool _cargando = true;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IReadOnlyList<UsuarioListadoDto> resultado = await UsuariosQuery.HandleAsync(CancellationToken.None);
            _usuarios = resultado.ToList();
        }
        catch (Exception ex)
        {
            _error = "Error al cargar los usuarios.";
            Logger.LogError(ex, "Error al listar usuarios");
        }
        finally
        {
            _cargando = false;
        }
    }
}

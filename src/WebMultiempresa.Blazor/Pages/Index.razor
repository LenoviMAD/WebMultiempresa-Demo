@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>WebMultiempresa — Inicio</PageTitle>

<div class="pt-page">

    <div class="pt-page-header">
        <div class="pt-page-header-left">
            <div class="pt-page-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </div>
            <div>
                <AuthorizeView>
                    <Authorized>
                        <h1 class="pt-page-title">Bienvenido, @ObtenerNombre(context)</h1>
                    </Authorized>
                </AuthorizeView>
                <p class="pt-page-sub">@_fecha</p>
            </div>
        </div>
    </div>

    <div class="dash-grid">

        <div class="pt-card">
            <div class="pt-card-header">
                <span class="pt-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                        <line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                    Combos
                </span>
            </div>
            <p class="dash-desc">Gestioná las promociones y combos de productos disponibles para la fuerza de ventas.</p>
            <div class="dash-actions">
                <a href="/combos" class="dash-btn-sec">Ver todos</a>
                <a href="/combos/nuevo" class="dash-btn-pri">+ Nuevo</a>
            </div>
        </div>

        <div class="pt-card">
            <div class="pt-card-header">
                <span class="pt-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Vendedores
                </span>
            </div>
            <p class="dash-desc">Administrá los vendedores: altas, modificaciones y asignaciones a combos.</p>
            <div class="dash-actions">
                <a href="/vendedores" class="dash-btn-sec">Ver todos</a>
                <a href="/vendedores/nuevo" class="dash-btn-pri">+ Nuevo</a>
            </div>
        </div>

        <div class="pt-card">
            <div class="pt-card-header">
                <span class="pt-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                    Productos
                </span>
            </div>
            <p class="dash-desc">Consultá y administrá el catálogo completo de productos de la empresa.</p>
            <div class="dash-actions">
                <a href="/productos" class="dash-btn-sec">Ver catálogo</a>
            </div>
        </div>

        <div class="pt-card">
            <div class="pt-card-header">
                <span class="pt-card-title">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Usuarios
                </span>
            </div>
            <p class="dash-desc">Gestioná el acceso al portal: roles, permisos y usuarios administradores.</p>
            <div class="dash-actions">
                <a href="/usuarios" class="dash-btn-sec">Ver todos</a>
                <a href="/usuarios/nuevo" class="dash-btn-pri">+ Nuevo</a>
            </div>
        </div>

    </div>
</div>

<style>
    .dash-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
    }

    .dash-desc {
        font-size: 0.875rem;
        color: #6b7280;
        line-height: 1.55;
        margin: 0;
    }

    .dash-actions {
        display: flex;
        gap: 0.5rem;
    }

    .dash-btn-pri {
        background: linear-gradient(135deg, #002b62 0%, #09388B 100%);
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 0.42rem 0.875rem;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.15s;
        display: inline-flex;
        align-items: center;
    }
    .dash-btn-pri:hover { opacity: 0.88; color: #fff; }

    .dash-btn-sec {
        background: #f0f4f8;
        color: #374151;
        border: 1px solid #dce8f8;
        border-radius: 7px;
        padding: 0.42rem 0.875rem;
        font-size: 0.82rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
        display: inline-flex;
        align-items: center;
    }
    .dash-btn-sec:hover { background: #dce8f8; color: #374151; }
</style>

@code {
    private string _fecha = string.Empty;

    protected override void OnInitialized()
    {
        System.Globalization.CultureInfo esAR = new("es-AR");
        string raw = DateTime.Today.ToString("dddd d 'de' MMMM 'de' yyyy", esAR);
        _fecha = char.ToUpper(raw[0]) + raw[1..];
    }

    private static string ObtenerNombre(AuthenticationState context)
    {
        System.Security.Claims.ClaimsPrincipal user = context.User;
        return user.FindFirst("name")?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.Identity?.Name
            ?? "Usuario";
    }
}

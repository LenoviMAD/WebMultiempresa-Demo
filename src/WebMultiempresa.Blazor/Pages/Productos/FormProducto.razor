@page "/productos/nuevo"
@page "/productos/{ProductosID:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using WebMultiempresa.Application.Commands.Productos
@using WebMultiempresa.Application.DTOs
@using WebMultiempresa.Application.Queries.Productos
@inject CrearProductoCommandHandler CrearHandler
@inject EditarProductoCommandHandler EditarHandler
@inject BajaProductoCommandHandler BajaHandler
@inject ObtenerProductoQuery ObtenerQuery
@inject NavigationManager Nav

<PageTitle>@(_esNuevo ? "Nuevo producto" : "Editar producto")</PageTitle>

<div class="pt-page">
    <div class="pt-page-header">
        <div class="pt-page-header-left">
            <div class="pt-page-icon">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 10V11"/>
                </svg>
            </div>
            <div>
                <h1 class="pt-page-title">@(_esNuevo ? "Nuevo producto" : _modelo.Nombre)</h1>
                <a href="/productos" class="pt-back-link">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"/>
                    </svg>
                    Productos
                </a>
            </div>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="pt-loading">Cargando...</div>
    }
    else
    {
        <div class="pt-body fp-centered">
            <div class="pt-card">
                <div class="pt-card-header">
                    <span class="pt-card-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.414-9.414a2 2 0 1 1 2.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        Datos del producto
                    </span>
                </div>

                <div class="pt-field-row fv-row" style="margin-top:15px; margin-left:20px; margin-right:20px; max-width:calc(100% - 40px);">
                    <div class="pt-ifield fv-field-code">
                        <label>Código <span class="pt-req">*</span></label>
                        <input type="text"
                               class="pt-input @(TieneError("Codigo") ? "pt-err" : "")"
                               @bind="_modelo.Codigo"
                               placeholder="PROD001"
                               maxlength="50" />
                        <ErrorMsg Mensaje="@Error("Codigo")" />
                    </div>
                    <div class="pt-ifield pt-flex1">
                        <label>Nombre <span class="pt-req">*</span></label>
                        <input type="text"
                               class="pt-input @(TieneError("Nombre") ? "pt-err" : "")"
                               @bind="_modelo.Nombre"
                               placeholder="Nombre del producto"
                               maxlength="200" />
                        <ErrorMsg Mensaje="@Error("Nombre")" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorGeneral))
                {
                    <div class="pt-alert-error-sm" style="margin:0 20px 0;">@_errorGeneral</div>
                }
            </div>

            @if (!_esNuevo)
            {
                <div class="pt-card">
                    <div class="pt-card-header">
                        <span class="pt-card-title">
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 0 1 0 2.828l-7 7a2 2 0 0 1-2.828 0l-7-7A2 2 0 0 1 3 12V7a4 4 0 0 1 4-4z"/>
                            </svg>
                            Precios por lista
                        </span>
                        <span class="pt-badge-count">@(_precios.Count) @(_precios.Count == 1 ? "lista" : "listas")</span>
                    </div>

                    @if (_precios.Count == 0)
                    {
                        <p class="pt-hint" style="margin:15px 20px 0;">Sin precios cargados para este producto.</p>
                    }
                    else
                    {
                        <div style="margin:12px 20px 0; max-width:calc(100% - 40px);">
                            <table class="pt-table pt-table-xs">
                                <thead>
                                    <tr>
                                        <th>Lista de precios</th>
                                        <th style="text-align:right;">Precio final</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (ProductoPrecioDto precio in _precios)
                                    {
                                        <tr>
                                            <td>@precio.NombreLista</td>
                                            <td style="text-align:right; font-variant-numeric:tabular-nums; font-weight:600; color:#002b62;">
                                                @precio.PrecioFinal.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            <div class="fp-actions">
                <div class="fp-actions-left">
                    @if (!_esNuevo)
                    {
                        <button class="pt-btn-footer-danger" type="button" @onclick="AbrirModalBaja">
                            Dar de baja
                        </button>
                    }
                </div>
                <div class="fp-actions-right">
                    <a href="/productos" class="pt-btn-footer-cancel">Cancelar</a>
                    <button class="pt-btn-footer-save" type="button" @onclick="GuardarAsync" disabled="@_guardando">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                        </svg>
                        @(_guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@if (_mostrarModalBaja)
{
    <div class="pt-modal-backdrop">
        <div class="pt-modal" style="width:420px;">
            <div class="pt-modal-header">
                <h3 class="pt-modal-title">Confirmar baja</h3>
                <button class="pt-modal-close" @onclick="() => _mostrarModalBaja = false">✕</button>
            </div>
            <div class="pt-modal-body">
                <p style="margin:0; color:#4b5563; font-size:0.9rem;">
                    ¿Está seguro que desea dar de baja el producto <strong>@_modelo.Nombre</strong>?
                </p>
            </div>
            <div class="pt-modal-footer">
                <button class="pt-modal-btn-cancel" @onclick="() => _mostrarModalBaja = false">Cancelar</button>
                <button class="pt-modal-btn-danger" @onclick="EjecutarBajaAsync">Confirmar baja</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? ProductosID { get; set; }

    private bool _esNuevo => ProductosID is null;
    private bool _cargando = true;
    private bool _guardando;
    private bool _mostrarModalBaja;
    private string _errorGeneral = string.Empty;
    private Dictionary<string, string> _errores = new();
    private List<ProductoPrecioDto> _precios = new();

    private ProductoFormModel _modelo = new();

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo)
        {
            ProductoDto? dto = await ObtenerQuery.HandleAsync(ProductosID!.Value, CancellationToken.None);
            if (dto is null)
            {
                Nav.NavigateTo("/productos");
                return;
            }
            _modelo.Codigo = dto.Codigo;
            _modelo.Nombre = dto.Nombre;
            _precios = dto.Precios?.ToList() ?? new List<ProductoPrecioDto>();
        }
        _cargando = false;
    }

    private async Task GuardarAsync()
    {
        _errores.Clear();
        _errorGeneral = string.Empty;

        if (string.IsNullOrWhiteSpace(_modelo.Codigo))
            _errores["Codigo"] = "El código es obligatorio.";
        if (string.IsNullOrWhiteSpace(_modelo.Nombre))
            _errores["Nombre"] = "El nombre es obligatorio.";

        if (_errores.Count > 0) return;

        _guardando = true;
        try
        {
            if (_esNuevo)
            {
                CrearProductoCommand cmd = new()
                {
                    Codigo = _modelo.Codigo,
                    Nombre = _modelo.Nombre
                };
                int nuevoId = await CrearHandler.HandleAsync(cmd, CancellationToken.None);
                Nav.NavigateTo($"/productos/{nuevoId}");
            }
            else
            {
                EditarProductoCommand cmd = new()
                {
                    ProductosID = ProductosID!.Value,
                    Codigo = _modelo.Codigo,
                    Nombre = _modelo.Nombre
                };
                await EditarHandler.HandleAsync(cmd, CancellationToken.None);
            }
        }
        catch (Domain.Exceptions.ProductoCodigoExistenteException ex)
        {
            _errores["Codigo"] = ex.Message;
        }
        catch (Exception ex)
        {
            _errorGeneral = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void AbrirModalBaja() => _mostrarModalBaja = true;

    private async Task EjecutarBajaAsync()
    {
        await BajaHandler.HandleAsync(ProductosID!.Value, CancellationToken.None);
        Nav.NavigateTo("/productos");
    }

    private string Error(string campo) =>
        _errores.TryGetValue(campo, out string? msg) ? msg : string.Empty;

    private bool TieneError(string campo) => _errores.ContainsKey(campo);

    private sealed class ProductoFormModel
    {
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }
}

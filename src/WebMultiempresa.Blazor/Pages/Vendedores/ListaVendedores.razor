@page "/vendedores"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using WebMultiempresa.Application.Commands.Vendedores
@using WebMultiempresa.Application.DTOs
@using WebMultiempresa.Application.Queries.Vendedores
@using WebMultiempresa.Application.Queries.CategoriasComerciales
@inject ListarVendedoresQuery VendedoresQuery
@inject ListarVendedoresDadosDeBajaQuery BajaQuery
@inject ListarCategoriasComercalesQuery CategoriasQuery
@inject ListarEstrellasDefinicionesQuery EstrellasDefQuery
@inject BajaVendedorCommandHandler BajaHandler
@inject ReactivarVendedorCommandHandler ReactivarHandler
@inject NavigationManager Nav

<PageTitle>Vendedores</PageTitle>

<div class="pt-page">

    <div class="pt-page-header">
        <div class="pt-page-header-left">
            <div class="pt-page-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div>
                <h1 class="pt-page-title">Vendedores</h1>
                <p class="pt-page-sub">
                    @if (_vistaActivos)
                    {
                        <span>@_vendedoresActivos.Count activos · @_disponibles.Count disponibles · @_categorias.Count rutas</span>
                    }
                    else
                    {
                        <span>Vendedores dados de baja</span>
                    }
                </p>
            </div>
        </div>
        <div class="pt-page-actions">
            <a href="/vendedores/configuracion-estrellas" class="pt-btn-secondary" title="Configurar plan de estrellas">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                Estrellas
            </a>
            <a href="/vendedores/nuevo" class="pt-btn-primary">+ Nuevo vendedor</a>
        </div>
    </div>

    <div class="vd-toolbar">
        <div class="vd-tabs">
            <button class="vd-tab @(_vistaActivos ? "vd-tab-active" : "")" @onclick="MostrarActivos">
                Activos
                @if (_vistaActivos && _vendedoresActivos.Count > 0)
                {
                    <span class="vd-tab-badge">@_vendedoresActivos.Count</span>
                }
            </button>
            <button class="vd-tab @(!_vistaActivos ? "vd-tab-active" : "")" @onclick="MostrarDadosDeBaja">
                Dados de baja
            </button>
        </div>
        <div class="pt-search-wrap" style="flex:1;max-width:360px;">
            <input class="pt-input pt-input-search" placeholder="Buscar por nombre o código..."
                   @bind="_busqueda" @bind:event="oninput" />
            <svg class="pt-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
        </div>
    </div>

    @if (_cargando)
    {
        <div class="pt-loading">Cargando vendedores...</div>
    }
    else if (_vistaActivos)
    {
        @* ── Vendedores activos agrupados por ruta ── *@
        @if (!_vendedoresFiltradosActivos.Any() && !_disponiblesFiltrados.Any())
        {
            <div class="pt-empty-state">
                @if (string.IsNullOrEmpty(_busqueda))
                { <span>No hay vendedores activos.</span> }
                else
                { <span>Sin resultados para "<strong>@_busqueda</strong>".</span> }
            </div>
        }
        else
        {
            @foreach (IGrouping<int?, VendedorListadoDto> grupo in _vendedoresFiltradosActivos
                .GroupBy(v => v.CategoriasComercialesID)
                .OrderBy(g => g.Key ?? int.MaxValue))
            {
                string rutaNombre = grupo.Key.HasValue && _categorias.TryGetValue(grupo.Key.Value, out string? nombre)
                    ? nombre
                    : "Sin ruta asignada";

                <div class="vd-ruta-header">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span>@rutaNombre</span>
                    <span class="vd-ruta-count">@grupo.Count() vendedor@(grupo.Count() != 1 ? "es" : "")</span>
                </div>

                <div class="pt-table-wrap vd-table-wrap">
                    <table class="pt-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Estrellas</th>
                                <th>WhatsApp</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (VendedorListadoDto v in grupo)
                            {
                                <tr>
                                    <td class="pt-mono">@v.Codigo</td>
                                    <td class="vd-nombre">@v.Nombre</td>
                                    <td class="vd-estrellas-cell">@RenderEstrellas(v)</td>
                                    <td class="vd-wa">
                                        @if (!string.IsNullOrEmpty(v.WhatsApp))
                                        { <span>@v.WhatsApp</span> }
                                        else
                                        { <span class="vd-empty">—</span> }
                                    </td>
                                    <td class="vd-actions">
                                        <a href="/vendedores/@v.VendedoresID" class="vd-pill vd-pill-edit">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                                            Editar
                                        </a>
                                        <a href="/vendedores/@v.VendedoresID/clientes" class="vd-pill vd-pill-clients">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                            Clientes
                                        </a>
                                        <a href="/vendedores/@v.VendedoresID/listas" class="vd-pill vd-pill-lists">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                                            Listas
                                        </a>
                                        <button class="vd-pill vd-pill-baja" @onclick="() => ConfirmarBaja(v)">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                            Baja
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* ── Rutas disponibles (sin persona asignada) ── *@
            @if (_disponiblesFiltrados.Any())
            {
                <div class="vd-ruta-header vd-ruta-disponible">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>Rutas disponibles</span>
                    <span class="vd-ruta-count">Sin persona asignada · @_disponiblesFiltrados.Count()</span>
                </div>

                <div class="pt-table-wrap vd-table-wrap">
                    <table class="pt-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Ruta</th>
                                <th>WhatsApp</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (VendedorListadoDto v in _disponiblesFiltrados)
                            {
                                string? rutaDisp = v.CategoriasComercialesID.HasValue &&
                                    _categorias.TryGetValue(v.CategoriasComercialesID.Value, out string? rn) ? rn : "—";
                                <tr class="vd-row-disponible">
                                    <td class="pt-mono">@v.Codigo</td>
                                    <td class="vd-nombre-disponible">@rutaDisp</td>
                                    <td class="vd-wa">
                                        @if (!string.IsNullOrEmpty(v.WhatsApp))
                                        { <span>@v.WhatsApp</span> }
                                        else
                                        { <span class="vd-empty">—</span> }
                                    </td>
                                    <td class="vd-actions">
                                        <a href="/vendedores/@v.VendedoresID" class="vd-pill vd-pill-edit">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                                            Editar
                                        </a>
                                        <button class="vd-pill vd-pill-baja" @onclick="() => ConfirmarBaja(v)">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                            Baja
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
    else
    {
        @* ── Dados de baja ── *@
        @if (!_vendedoresFiltrados.Any())
        {
            <div class="pt-empty-state">
                @if (string.IsNullOrEmpty(_busqueda))
                { <span>No hay vendedores dados de baja.</span> }
                else
                { <span>Sin resultados para "<strong>@_busqueda</strong>".</span> }
            </div>
        }
        else
        {
            <div class="pt-table-wrap">
                <table class="pt-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (VendedorListadoDto v in _vendedoresFiltrados)
                        {
                            <tr>
                                <td class="pt-mono">@v.Codigo</td>
                                <td>@v.Nombre</td>
                                <td class="vd-actions">
                                    <button class="vd-btn-success" @onclick="() => ConfirmarReactivar(v)">Reactivar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="pt-alert-error" role="alert">@_error</div>
    }

</div>

@* Modal baja *@
@if (_vendedorParaBaja is not null)
{
    <div class="pt-modal-backdrop" @onclick="CancelarModal">
        <div class="pt-modal" style="width:400px;" @onclick:stopPropagation="true">
            <div class="pt-modal-header">
                <span class="pt-modal-title">Confirmar baja</span>
            </div>
            <div class="pt-modal-body">
                <p style="margin:0;color:#374151;font-size:0.9rem;">
                    ¿Dar de baja al vendedor <strong>@_vendedorParaBaja.Nombre</strong>?
                </p>
            </div>
            <div class="pt-modal-footer">
                <button class="pt-modal-btn-cancel" @onclick="CancelarModal">Cancelar</button>
                <button class="pt-modal-btn-danger" @onclick="EjecutarBajaAsync" disabled="@_procesando">
                    @(_procesando ? "Procesando..." : "Dar de baja")
                </button>
            </div>
        </div>
    </div>
}

@* Modal reactivar *@
@if (_vendedorParaReactivar is not null)
{
    <div class="pt-modal-backdrop" @onclick="CancelarModal">
        <div class="pt-modal" style="width:400px;" @onclick:stopPropagation="true">
            <div class="pt-modal-header">
                <span class="pt-modal-title">Confirmar reactivación</span>
            </div>
            <div class="pt-modal-body">
                <p style="margin:0;color:#374151;font-size:0.9rem;">
                    ¿Reactivar al vendedor <strong>@_vendedorParaReactivar.Nombre</strong>?
                </p>
            </div>
            <div class="pt-modal-footer">
                <button class="pt-modal-btn-cancel" @onclick="CancelarModal">Cancelar</button>
                <button class="vd-btn-confirm-ok" @onclick="EjecutarReactivarAsync" disabled="@_procesando">
                    @(_procesando ? "Procesando..." : "Reactivar")
                </button>
            </div>
        </div>
    </div>
}

<style>
    /* ── Toolbar ── */
    .vd-toolbar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .vd-tabs {
        display: flex;
        background: #fff;
        border: 1px solid #dce8f8;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(9,56,139,0.07);
    }

    .vd-tab {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 1.1rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: none;
        cursor: pointer;
        background: transparent;
        color: #6b7280;
        transition: background 0.12s, color 0.12s;
        font-family: inherit;
    }
    .vd-tab:hover { background: #f0f4f8; color: #002b62; }
    .vd-tab-active {
        background: linear-gradient(135deg, #002b62 0%, #09388B 100%);
        color: #fff;
        font-weight: 600;
    }
    .vd-tab-badge {
        background: rgba(255,255,255,0.25);
        border-radius: 99px;
        padding: 0.05rem 0.45rem;
        font-size: 0.75rem;
        font-weight: 700;
    }
    .vd-tab:not(.vd-tab-active) .vd-tab-badge {
        background: #e5e7eb;
        color: #374151;
    }

    /* ── Ruta header ── */
    .vd-ruta-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0 0.4rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: #09388B;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-bottom: 2px solid #dce8f8;
        margin-bottom: 0.5rem;
        margin-top: 1rem;
    }
    .vd-ruta-header:first-of-type { margin-top: 0; }
    .vd-ruta-header svg { color: #09388B; flex-shrink: 0; }
    .vd-ruta-count {
        margin-left: auto;
        font-size: 0.72rem;
        font-weight: 500;
        color: #9ca3af;
        text-transform: none;
        letter-spacing: 0;
    }

    /* Rutas disponibles */
    .vd-ruta-disponible {
        color: #9ca3af;
        border-bottom-color: #e5e7eb;
        margin-top: 1.5rem;
    }
    .vd-ruta-disponible svg { color: #9ca3af; }

    .vd-row-disponible td { background: #fafafa; color: #9ca3af; }
    .vd-nombre-disponible { font-style: italic; color: #9ca3af !important; }

    /* ── Tabla ── */
    .vd-table-wrap { margin-bottom: 0.25rem; }
    .vd-nombre { font-weight: 500; color: #111827; }
    .vd-wa { color: #6b7280; font-size: 0.85rem; }
    .vd-empty { color: #d1d5db; }

    /* ── Estrellas con tooltip CSS ── */
    .vd-estrellas-cell { white-space: nowrap; }

    .vd-star {
        position: relative;
        font-size: 1rem;
        cursor: default;
        display: inline-block;
    }

    /* Tooltip via data-tip */
    .vd-star::after {
        content: attr(data-tip);
        position: absolute;
        bottom: 130%;
        left: 50%;
        transform: translateX(-50%);
        background: #002b62;
        color: #fff;
        padding: 0.25rem 0.55rem;
        border-radius: 5px;
        font-size: 0.7rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.15s;
        z-index: 200;
        box-shadow: 0 2px 8px rgba(0,43,98,0.3);
    }
    .vd-star:hover::after { opacity: 1; }

    .vd-star-on  { color: #f59e0b; }
    .vd-star-off { color: #e5e7eb; }
    .vd-no-data  { color: #d1d5db; font-size: 0.78rem; font-style: italic; }

    /* ── Actions ── */
    .vd-actions {
        display: flex;
        gap: 0.375rem;
        align-items: center;
        white-space: nowrap;
    }

    /* Pill base */
    .vd-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.22rem 0.62rem;
        border-radius: 99px;
        font-size: 0.775rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        text-decoration: none;
        border: 1.5px solid transparent;
        transition: background 0.14s, color 0.14s, border-color 0.14s, box-shadow 0.14s;
        line-height: 1.4;
    }

    /* Editar — azul marino outline */
    .vd-pill-edit {
        color: #09388B;
        background: #eef4ff;
        border-color: #bfdbfe;
    }
    .vd-pill-edit:hover {
        background: linear-gradient(135deg, #002b62 0%, #09388B 100%);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 2px 8px rgba(0,43,98,0.28);
    }

    /* Clientes — teal */
    .vd-pill-clients {
        color: #0d9488;
        background: #f0fdfa;
        border-color: #99f6e4;
    }
    .vd-pill-clients:hover {
        background: #0d9488;
        color: #fff;
        border-color: transparent;
        box-shadow: 0 2px 8px rgba(13,148,136,0.28);
    }

    /* Listas — gris neutro */
    .vd-pill-lists {
        color: #4b5563;
        background: #f3f4f6;
        border-color: #d1d5db;
    }
    .vd-pill-lists:hover {
        background: #374151;
        color: #fff;
        border-color: transparent;
        box-shadow: 0 2px 8px rgba(55,65,81,0.22);
    }

    /* Baja — rojo */
    .vd-pill-baja {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
    }
    .vd-pill-baja:hover {
        background: #dc2626;
        color: #fff;
        border-color: transparent;
        box-shadow: 0 2px 8px rgba(220,38,38,0.28);
    }
    .vd-btn-success {
        color: #16a34a;
        font-size: 0.82rem;
        font-weight: 600;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 6px;
        padding: 0.3rem 0.75rem;
        cursor: pointer;
        font-family: inherit;
    }
    .vd-btn-success:hover { background: #dcfce7; }
    .vd-btn-confirm-ok {
        background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.52rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
    }
    .vd-btn-confirm-ok:hover:not(:disabled) { opacity: 0.9; }
    .vd-btn-confirm-ok:disabled { opacity: 0.6; cursor: not-allowed; }
</style>

@code {
    private List<VendedorListadoDto> _vendedores = new();
    private List<VendedorListadoDto> _vendedoresActivos = new();
    private List<VendedorListadoDto> _disponibles = new();
    private Dictionary<int, string> _categorias = new();
    private List<VendedorEstrellasDefinicionDto> _estrellaDefs = new();

    private bool _vistaActivos = true;
    private bool _cargando = true;
    private string _error = string.Empty;
    private string _busqueda = string.Empty;
    private VendedorListadoDto? _vendedorParaBaja;
    private VendedorListadoDto? _vendedorParaReactivar;
    private bool _procesando;

    private static bool EsDisponible(VendedorListadoDto v) =>
        v.Nombre.Contains("DISPONIBLE", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<VendedorListadoDto> _vendedoresFiltradosActivos =>
        (string.IsNullOrWhiteSpace(_busqueda)
            ? _vendedoresActivos
            : _vendedoresActivos.Where(v =>
                v.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                v.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<VendedorListadoDto> _disponiblesFiltrados =>
        (string.IsNullOrWhiteSpace(_busqueda)
            ? _disponibles
            : _disponibles.Where(v =>
                v.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<VendedorListadoDto> _vendedoresFiltrados =>
        string.IsNullOrWhiteSpace(_busqueda)
            ? _vendedores
            : _vendedores.Where(v =>
                v.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                v.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await CargarActivos();

    private async Task MostrarActivos()
    {
        if (_vistaActivos) return;
        _vistaActivos = true;
        _busqueda = string.Empty;
        await CargarActivos();
    }

    private async Task MostrarDadosDeBaja()
    {
        if (!_vistaActivos) return;
        _vistaActivos = false;
        _busqueda = string.Empty;
        await CargarDadosDeBaja();
    }

    private async Task CargarActivos()
    {
        _cargando = true;
        _error = string.Empty;
        try
        {
            IReadOnlyList<VendedorListadoDto> resultado = await VendedoresQuery.HandleAsync(CancellationToken.None);

            _vendedoresActivos = resultado.Where(v => !EsDisponible(v)).ToList();
            _disponibles = resultado.Where(EsDisponible).ToList();

            IReadOnlyList<CategoriaComercialDto> cats = await CategoriasQuery.HandleAsync(CancellationToken.None);
            _categorias = cats.ToDictionary(c => c.CategoriasComercialesID, c => c.Nombre);

            IReadOnlyList<VendedorEstrellasDefinicionDto> defs = await EstrellasDefQuery.HandleAsync(CancellationToken.None);
            _estrellaDefs = defs.OrderBy(d => d.NumeroEstrella).ToList();
        }
        catch
        {
            _error = "Error al cargar los vendedores. Verifique la conexión.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarDadosDeBaja()
    {
        _cargando = true;
        _error = string.Empty;
        try
        {
            IReadOnlyList<VendedorListadoDto> resultado = await BajaQuery.HandleAsync(CancellationToken.None);
            _vendedores = resultado.Where(v => !EsDisponible(v)).ToList();
        }
        catch
        {
            _error = "Error al cargar los vendedores dados de baja. Verifique la conexión.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private RenderFragment RenderEstrellas(VendedorListadoDto v) => builder =>
    {
        if (_estrellaDefs.Count == 0)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "vd-no-data");
            builder.AddContent(2, "—");
            builder.CloseElement();
            return;
        }

        IReadOnlySet<int>? encendidas = v.EstrellaDefinicionesEncendidas;
        int seq = 0;

        foreach (VendedorEstrellasDefinicionDto def in _estrellaDefs)
        {
            bool on = encendidas?.Contains(def.VendedorEstrellasDefinicionesID) ?? false;
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", $"vd-star {(on ? "vd-star-on" : "vd-star-off")}");
            builder.AddAttribute(seq++, "data-tip", def.Nombre);
            builder.AddAttribute(seq++, "title", def.Nombre);
            builder.AddContent(seq++, "★");
            builder.CloseElement();
        }
    };

    private void ConfirmarBaja(VendedorListadoDto vendedor) => _vendedorParaBaja = vendedor;
    private void ConfirmarReactivar(VendedorListadoDto vendedor) => _vendedorParaReactivar = vendedor;

    private void CancelarModal()
    {
        _vendedorParaBaja = null;
        _vendedorParaReactivar = null;
    }

    private async Task EjecutarBajaAsync()
    {
        if (_vendedorParaBaja is null) return;
        _procesando = true;
        try
        {
            await BajaHandler.HandleAsync(_vendedorParaBaja.VendedoresID, CancellationToken.None);
            _vendedoresActivos.RemoveAll(v => v.VendedoresID == _vendedorParaBaja.VendedoresID);
            _disponibles.RemoveAll(v => v.VendedoresID == _vendedorParaBaja.VendedoresID);
            _vendedorParaBaja = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task EjecutarReactivarAsync()
    {
        if (_vendedorParaReactivar is null) return;
        _procesando = true;
        try
        {
            await ReactivarHandler.HandleAsync(new ReactivarVendedorCommand { VendedoresID = _vendedorParaReactivar.VendedoresID }, CancellationToken.None);
            _vendedores.RemoveAll(v => v.VendedoresID == _vendedorParaReactivar.VendedoresID);
            _vendedorParaReactivar = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _procesando = false;
        }
    }
}

    private void IniciarAgregarCC()
    {
        _ccAdding = true;
        if (_modelo.ComboDinamico)
            SincronizarCantidadDesdeGrupo();
    }

    private void SincronizarCantidadDesdeGrupo()
    {
        GrupoDinamicoFormModel? grupo = _modelo.GruposDinamicos.FirstOrDefault(g => g.Numero == _ccGrupo);
        if (grupo is not null)
            _ccCantidad = grupo.Cantidad;
    }

    private void SincronizarComboDinamico()
    {
        if (_modelo.ComboDinamico)
        {
            if (_modelo.GruposDinamicos.Count == 0)
            {
                _modelo.GruposDinamicos.Add(new GrupoDinamicoFormModel
                {
                    Numero = 1,
                    Cantidad = Convert.ToInt32(_modelo.CantidadDinamica)
                });
            }

            if (_ccGrupo == 0)
            {
                _ccGrupo = _modelo.GruposDinamicos[0].Numero;
            }

            RecalcularCantidadDinamica();
            return;
        }

        _modelo.CantidadDinamica = 0;
        _modelo.GruposDinamicos.Clear();

        foreach (ComboItemFormModel item in ItemsConCargo)
        {
            item.NroGrupoDinamico = 0;
        }

        _ccGrupo = 1;
    }

    private void AgregarGrupoDinamico()
    {
        int siguienteNumero = _modelo.GruposDinamicos.Count == 0
            ? 1
            : _modelo.GruposDinamicos.Max(g => g.Numero) + 1;

        _modelo.GruposDinamicos.Add(new GrupoDinamicoFormModel
        {
            Numero = siguienteNumero,
            Cantidad = 0
        });

        _ccGrupo = siguienteNumero;
        RecalcularCantidadDinamica();
    }

    private void RecalcularCantidadDinamica()
    {
        _modelo.CantidadDinamica = _modelo.GruposDinamicos.Sum(g => Convert.ToDecimal(g.Cantidad));
    }

    private void InicializarGruposDinamicosDesdeItems()
    {
        _modelo.GruposDinamicos.Clear();

        if (!_modelo.ComboDinamico)
        {
            return;
        }

        List<int> grupos = ItemsConCargo
            .Where(i => i.NroGrupoDinamico > 0)
            .Select(i => i.NroGrupoDinamico)
            .Distinct()
            .OrderBy(g => g)
            .ToList();

        if (grupos.Count == 0)
        {
            _modelo.GruposDinamicos.Add(new GrupoDinamicoFormModel
            {
                Numero = 1,
                Cantidad = Convert.ToInt32(_modelo.CantidadDinamica)
            });
        }
        else
        {
            foreach (int grupo in grupos)
            {
                decimal cantidadGrupo = ItemsConCargo
                    .Where(i => i.NroGrupoDinamico == grupo)
                    .Sum(i => i.Cantidad);

                _modelo.GruposDinamicos.Add(new GrupoDinamicoFormModel
                {
                    Numero = grupo,
                    Cantidad = Convert.ToInt32(cantidadGrupo)
                });
            }
        }

        RecalcularCantidadDinamica();
        _ccGrupo = _modelo.GruposDinamicos[0].Numero;
    }

    private void AgregarConCargo()
    {
        if (_ccProdID == 0) return;
        ProductoDto? prod = _productos.FirstOrDefault(p => p.ProductosID == _ccProdID);
        if (prod is null || _modelo.Items.Any(i => i.ProductosID == _ccProdID && i.Tipo == 1)) return;
        _modelo.Items.Add(new ComboItemFormModel
        {
            ProductosID = prod.ProductosID,
            NombreProducto = prod.Nombre,
            CodigoProducto = prod.Codigo,
            Cantidad = _ccCantidad,
            Precio = _ccPrecio,
            Tipo = 1,
            NroGrupoDinamico = _modelo.ComboDinamico ? _ccGrupo : 0
        });
        _ccProdID = 0;
        _ccCantidad = 1;
        _ccPrecio = 0m;
        _ccGrupo = 1;
        _ccProductoTexto = string.Empty;
        _ccAdding = false;
    }

    private void SeleccionarProductoConCargo(ChangeEventArgs args)
    {
        _ccProductoTexto = args.Value?.ToString() ?? string.Empty;

        ProductoDto? productoSeleccionado = _productos.FirstOrDefault(p =>
            string.Equals(FormatearProductoOption(p), _ccProductoTexto, StringComparison.OrdinalIgnoreCase));

        _ccProdID = productoSeleccionado?.ProductosID ?? 0;
        _ccPrecio = productoSeleccionado?.PrecioCosto ?? 0m;
    }

    private static string FormatearProductoOption(ProductoDto producto) => $"[{producto.Codigo}] {producto.Nombre}";
    private static string FormatearPrecio(decimal precio) => precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);


    private async Task GuardarAsync()
    {
        _errores.Clear();
        _errorGlobal = string.Empty;

        if (!Validar()) return;

        _guardando = true;

        try
        {
            if (_esNuevo)
            {
                int id = await CrearHandler.HandleAsync(MapearCrear(), CancellationToken.None);
                Nav.NavigateTo($"/combos/{id}");
            }
            else
            {
                await EditarHandler.HandleAsync(MapearEditar(), CancellationToken.None);
                Nav.NavigateTo("/combos");
            }
        }
        catch (Domain.Exceptions.ComboCodigoExistenteException)
        {
            _errores["Codigo"] = $"El código '{_modelo.Codigo}' ya existe en esta empresa.";
            _tab = 0;
        }
        catch (Domain.Exceptions.ComboSinTipoClienteException)
        {
            _errores["Clientes"] = "Seleccione al menos un tipo de cliente.";
            _tab = 0;
        }
        catch (Domain.Exceptions.ComboSinListaPrecioException)
        {
            _errores["Clientes"] = "Agregue al menos un producto o active 'Todas las listas de precios'.";
            _tab = 0;
        }
        catch
        {
            _errorGlobal = "Error al guardar. Intente nuevamente.";
        }
        finally
        {
            _guardando = false;
        }
    }

    private void ConfirmarBaja() => _mostrarConfirmBaja = true;

    private async Task EjecutarBajaAsync()
    {
        _mostrarConfirmBaja = false;
        _guardando = true;
        try
        {
            await BajaHandler.HandleAsync(CombosID!.Value, CancellationToken.None);
            Nav.NavigateTo("/combos");
        }
        catch { _errorGlobal = "Error al dar de baja."; }
        finally { _guardando = false; }
    }

    private bool Validar()
    {
        if (string.IsNullOrWhiteSpace(_modelo.Codigo))
            _errores["Codigo"] = "El código es obligatorio.";
        else if (_modelo.Codigo.Length > 10)
            _errores["Codigo"] = "Máximo 10 caracteres.";

        if (string.IsNullOrWhiteSpace(_modelo.Nombre))
            _errores["Nombre"] = "El nombre es obligatorio.";

        if (_modelo.MarcasProductosID is null or 0)
            _errores["MarcasProductosID"] = "Seleccione una categoría.";

        if (_modelo.FechaVigencia < _modelo.FechaInicio)
            _errores["FechaVigencia"] = "La vigencia debe ser posterior al inicio.";

        if (!_modelo.ClientesNumericos && !_modelo.ClientesAlfaNumericos)
            _errores["TipoCliente"] = "Seleccione al menos un tipo de cliente (Salón o Distribución).";

        if (!_modelo.TodasLasListasPrecios && _modelo.ListasPreciosIDs.Count == 0)
            _errores["ListasPrecios"] = "Seleccione al menos una lista de precios o active 'Todas las listas'.";

        return _errores.Count == 0;
    }


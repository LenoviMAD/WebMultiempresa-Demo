@using Microsoft.AspNetCore.Components.Authorization

<div class="sidebar @(_collapsed ? "sidebar-collapsed" : "")">

    <div class="sidebar-brand">
        <a href="/" class="brand-link">
            <img src="img/vendixIcono.png" alt="WebMultiempresa" class="brand-icon" />
            <span class="brand-name">WebMultiempresa</span>
        </a>
        <button class="sidebar-toggle" @onclick="() => _collapsed = !_collapsed"
                title="@(_collapsed ? "Expandir menú" : "Contraer menú")">
            @if (_collapsed)
            {
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            }
            else
            {
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            }
        </button>
    </div>

    <nav class="sidebar-nav">

        <div class="nav-section">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" title="Inicio">
                <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span>Inicio</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-section-label"><span>Gestión</span></div>

                <div class="nav-section">
                    <NavLink class="nav-link" href="/combos" title="Combos">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                            <line x1="12" y1="22.08" x2="12" y2="12"/>
                        </svg>
                        <span>Combos</span>
                    </NavLink>
                </div>

                <div class="nav-section">
                    <NavLink class="nav-link" href="/vendedores" title="Vendedores">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        <span>Vendedores</span>
                    </NavLink>
                </div>

                <div class="nav-section">
                    <NavLink class="nav-link" href="/productos" title="Productos">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                        <span>Productos</span>
                    </NavLink>
                </div>

                <div class="nav-section">
                    <NavLink class="nav-link" href="/usuarios" title="Usuarios">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span>Usuarios</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="SuperAdmin">
            <Authorized>
                <div class="nav-section-label"><span>Administración</span></div>

                <div class="nav-section">
                    <NavLink class="nav-link" href="/empresas" title="Empresas">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="7" width="20" height="14" rx="2"/>
                            <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                            <line x1="12" y1="12" x2="12" y2="16"/>
                            <line x1="10" y1="14" x2="14" y2="14"/>
                        </svg>
                        <span>Empresas</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>


</div>

<style>
    .sidebar {
        width: 220px;
        min-height: 100vh;
        background: linear-gradient(180deg, #002b62 0%, #09388B 60%, #165DC9 100%);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: width 0.25s ease;
        overflow: hidden;
    }

    .sidebar-collapsed { width: 64px; }

    /* ── Brand ── */
    .sidebar-brand {
        padding: 0.875rem 0.75rem 0.875rem 0.875rem;
        border-bottom: 1px solid rgba(255,255,255,0.12);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .brand-link {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        text-decoration: none;
        overflow: hidden;
        white-space: nowrap;
        flex: 1;
        min-width: 0;
    }

    .brand-icon {
        width: 30px;
        height: 30px;
        object-fit: contain;
        flex-shrink: 0;
        filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3));
    }

    .brand-name {
        color: #fff;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        transition: opacity 0.2s, width 0.25s;
        overflow: hidden;
    }

    .sidebar-collapsed .brand-name {
        opacity: 0;
        width: 0;
    }

    /* ── Nav ── */
    .sidebar-nav {
        padding: 0.625rem 0;
        flex: 1;
        overflow: hidden;
    }

    .nav-section-label {
        padding: 0.875rem 1rem 0.2rem;
        font-size: 0.68rem;
        font-weight: 700;
        color: rgba(255,255,255,0.38);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        overflow: hidden;
        white-space: nowrap;
        transition: opacity 0.15s, max-height 0.25s, padding 0.25s;
        max-height: 40px;
    }

    .sidebar-collapsed .nav-section-label {
        opacity: 0;
        max-height: 0;
        padding-top: 0;
        padding-bottom: 0;
    }

    .nav-section {
        padding: 0 0.5rem;
        margin-bottom: 0.1rem;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.6rem 0.75rem;
        border-radius: 8px;
        color: rgba(255,255,255,0.75);
        font-size: 0.875rem;
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
        white-space: nowrap;
        overflow: hidden;
    }

    .nav-link:hover {
        background: rgba(255,255,255,0.12);
        color: #fff;
    }

    .nav-link.active {
        background: rgba(255,255,255,0.20);
        color: #fff;
        font-weight: 600;
    }

    .nav-icon { flex-shrink: 0; }

    .sidebar-collapsed .nav-link {
        justify-content: center;
        padding: 0.65rem;
    }

    .sidebar-collapsed .nav-link span {
        display: none;
    }

    /* ── Toggle button (brand area) ── */
    .sidebar-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 28px;
        height: 28px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 6px;
        color: rgba(255,255,255,0.75);
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        padding: 0;
    }

    .sidebar-toggle:hover {
        background: rgba(255,255,255,0.22);
        color: #fff;
    }
</style>

@code {
    private bool _collapsed;
}

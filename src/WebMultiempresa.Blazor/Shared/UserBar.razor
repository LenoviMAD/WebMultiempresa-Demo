@using Microsoft.AspNetCore.Components.Authorization
@using WebMultiempresa.Blazor.Auth
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <div class="user-bar">
            <div class="user-avatar">
                @ObtenerIniciales(context)
            </div>
            <span class="user-name">@ObtenerNombre(context)</span>
            <button class="btn-logout" @onclick="CerrarSesionAsync" title="Cerrar sesión">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Salir
            </button>
        </div>
    </Authorized>
</AuthorizeView>

<style>
    .user-bar {
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }

    .user-avatar {
        width: 30px;
        height: 30px;
        background: linear-gradient(135deg, #002b62 0%, #09388B 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        flex-shrink: 0;
        letter-spacing: 0.02em;
    }

    .user-name {
        font-size: 0.825rem;
        color: #374151;
        font-weight: 500;
        max-width: 160px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-logout {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        background: none;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        padding: 0.3rem 0.7rem;
        font-size: 0.8rem;
        color: #6b7280;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
        font-family: inherit;
    }

    .btn-logout:hover {
        background: #fef2f2;
        border-color: #fecaca;
        color: #dc2626;
    }
</style>

@code {
    private async Task CerrarSesionAsync()
    {
        BlazorAuthStateProvider provider = (BlazorAuthStateProvider)AuthProvider;
        await provider.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    private static string ObtenerNombre(AuthenticationState context)
    {
        System.Security.Claims.ClaimsPrincipal user = context.User;
        return user.FindFirst("name")?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.Identity?.Name
            ?? "Usuario";
    }

    private static string ObtenerIniciales(AuthenticationState context)
    {
        string nombre = ObtenerNombre(context);
        string[] partes = nombre.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
            return $"{partes[0][0]}{partes[1][0]}".ToUpper();
        return nombre.Length > 0 ? nombre[0].ToString().ToUpper() : "U";
    }
}
